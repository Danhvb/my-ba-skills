{
  "name": "multi-agent-ba",
  "version": "0.1.0",
  "description": "Multi-agent BA system with skill orchestration and knowledge learning",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "bin": {
    "ba-agent": "./dist/cli/index.js"
  },
  "keywords": [
    "business-analysis",
    "multi-agent",
    "ai",
    "llm",
    "orchestration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "commander": "^12.1.0",
    "inquirer": "^9.2.12",
    "chalk": "^5.4.1",
    "ora": "^8.1.1",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.6",
    "glob": "^11.0.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "eslint": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}